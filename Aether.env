# Aether configuration loaded by services/aether/config.js.
# Keep credentials in the deployment secret store or Chamy's private .env;
# this file contains only Aether runtime configuration.

# Legacy Aether runtime settings
# Credential placeholders are intentionally blank. Chamy uses its deployment
# secret store for Discord/Mongo credentials and does not read them from here.
DISCORD_TOKEN=
DATABASE_URL=sqlite:///data.db
PROOF_STORAGE_TYPE=local
PROOF_STORAGE_PATH=./proof
SUBMIT_RATE_LIMIT_SECONDS=2.0
MAX_PROOF_FILE_SIZE_MB=50
MAX_CACHE_SIZE=1000
RATE_LIMITER_MAX_ENTRIES=10000
LOG_LEVEL=INFO
SENTRY_DSN=
BOT_VERSION=

# Guild-independent role defaults. Guild documents may override these values.
ALLOWED_START_ROLE_IDS=1488185947949367376,1402248194095579266
AETHER_START_ROLE_IDS=1488185947949367376,1402248194095579266
AETHER_ADMIN_ROLE_IDS=
AETHER_ALLOWED_ROLE_IDS=1488185947949367376,1402248194095579266
AETHER_ROLE_ORDER=1488185947949367376,1402248194095579266

# Series limits
SERIES_MAX_ROUNDS_F1=12
SERIES_MAX_ROUNDS_F2=12
SERIES_MAX_ROUNDS_F3=12
SERIES_MAX_ROUNDS_F4=12

# Tyres and session weather rules
TYRE_SOFT=soft
TYRE_MEDIUM=medium
TYRE_HARD=hard
TYRE_INTERMEDIATE=intermediate
TYRE_WET=wet
VALID_TYRES=soft,medium,hard,intermediate,wet
TYRE_WET_RACE=wet
TYRE_WET_QUALIFYING=wet
TYRE_WET_SPRINT=wet
TYRE_WET_PRACTICE=wet
TYRE_WET_WARMUP=wet
TYRE_DRY_RACE=soft
TYRE_DRY_QUALIFYING=medium
TYRE_DRY_SPRINT=hard
TYRE_DRY_PRACTICE=medium
TYRE_DRY_WARMUP=medium

# Qualifying reductions, in centiseconds
QUALIFYING_REDUCTION_P1=20
QUALIFYING_REDUCTION_P2=18
QUALIFYING_REDUCTION_P3=16
QUALIFYING_REDUCTION_P4=14
QUALIFYING_REDUCTION_P5=12
QUALIFYING_REDUCTION_P6=10
QUALIFYING_REDUCTION_P7=8
QUALIFYING_REDUCTION_P8=6
QUALIFYING_REDUCTION_P9=4
QUALIFYING_REDUCTION_P10=2

# Submission and leaderboard limits
DEFAULT_TOTAL_ATTEMPTS=5
SUBMISSION_COOLDOWN_SECONDS=60
MAX_LEADERBOARD_ENTRIES=50
DISCORD_MESSAGE_LIMIT=2000
SHOW_DRIVER_NUMBER=true
SHOW_TEAM_EMOJI=true
SHOW_TYRE_EMOJI=true

# Announcement and rules
LEAGUE_ROLE_ID=1314685533573611551
SERIES_ROLE_ID_F1=1314685533573611551
SERIES_ROLE_ID_F2=1314685629644275793
SERIES_ROLE_ID_F3=1314685533573611551
SERIES_ROLE_ID_F4=1314685533573611551
ANNOUNCEMENT_TITLE_FORMAT={series} {session_type} - {country}
TRACK_LIMITS=true

# Cache settings
CACHE_TTL_LEADERBOARD=300
CACHE_TTL_SUBMISSIONS=60
CACHE_TTL_PROFILES=600
CACHE_TTL_SESSIONS=300
CACHE_ENABLED=true

# Validation and feature flags
ALLOW_LAP_TIME_EDIT=true
ALLOW_TYRE_EDIT=true
MIN_LAP_TIME_CS=10000
MAX_LAP_TIME_CS=1000000
FEATURE_QUALIFYING_REDUCTIONS=true
FEATURE_WEATHER_SPECIFIC_TYRES=true
FEATURE_RATE_LIMITING=true
FEATURE_ANNOUNCEMENTS=true
REQUIRE_VERIFIED_TEAM=true
LOG_SUBMISSIONS=true
ENABLE_INTEGRITY_CHECKS=true
VALIDATE_LEADERBOARD_DATA=true
